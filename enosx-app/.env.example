# Optional Neon-backed API base URL for server-only features such as CEO profile access.
VITE_NEON_API_URL=

# Firebase Web App configuration (public client settings; restrict the API key in Google Cloud).
# Create these values in Firebase Console → Project settings → Your apps → Web app.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Firebase Auth providers must also be enabled in Firebase Console.

# Server-side NVIDIA credentials for ENOSX AI chat and image generation.
# Never expose these keys with a VITE_ prefix.
NVIDIA_API_KEY=
NVIDIA_IMAGE_API_KEY=
# NVIDIA hosted FLUX.1 Kontext-dev endpoint for edits with an attached image.
# Prompt-only generation is routed server-side to hosted FLUX.2 Klein 4B.
NVIDIA_IMAGE_ENDPOINT=https://ai.api.nvidia.com/v1/genai/black-forest-labs/flux.1-kontext-dev
NVIDIA_IMAGE_MODEL=black-forest-labs/flux.1-kontext-dev
PUBLIC_APP_URL=https://enosx.ai
